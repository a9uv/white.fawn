---
/**
 * about.astro — About Page
 *
 * Sections:
 *  1. Hero Header (Big header up top with page lead and credentials)
 *  2. Our Mission (Core purpose, manifesto, and pillars)
 *  3. Our Vision (Long-term commitment to community sovereignty and sustainable technology)
 *  4. Our Team (Multidisciplinary profiles with styled image placeholders)
 *  5. Contact Box (Prominent glass callout card)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { url } from "../data/nav.ts";

// Single current team member
const founder = {
  name: "Jorge Saiz",
  role: "Founder",
  initials: "JS",
  bio: "With over six years of dedicated consulting experience, Jorge specializes in integrating Indigenous Environmental Knowledge and cultural practices to address complex ecological challenges and enhance land stewardship. A Madison native and graduate of the University of New Mexico – Albuquerque, he partners with nonprofits, educational bodies, and community organizations to build resilient, culturally grounded environmental solutions across the Midwest.",
};

/* ── Card template data preserved for future expansion ─────────────────────
const futureTeamMembersTemplate = [
  {
    name: "Jorge Saiz",
    role: "Founder",
    initials: "JS",
    tags: ["Indigenous Environmental Knowledge", "Cultural Practices", "Ecological Systems"],
    bio: "With over six years of dedicated consulting experience, Jorge specializes in integrating Indigenous Environmental Knowledge and cultural practices to address complex ecological challenges and enhance land stewardship. A Madison native and graduate of the University of New Mexico – Albuquerque, he partners with nonprofits, educational bodies, and community organizations to build resilient, culturally grounded environmental solutions across the Midwest.",
  },
 
];
──────────────────────────────────────────────────────────────────────────── */
---

<BaseLayout
  title="About Us"
  description="Learn about White Fawn LLC: our mission, vision, multidisciplinary team, and commitment to academic thought and technical implementation for Midwest organizations."
>
  {
    /* ═══════════════════════════════════════════════════════════════════════
      1. Big Header Up Top
      ═══════════════════════════════════════════════════════════════════════ */
  }
  <header class="about-hero section" aria-labelledby="about-hero-title">
    <div class="container about-hero-inner">
      <!-- <div class="hero-header-badge">
        <span class="badge-dot"></span>
        <span class="about-eyebrow">About White Fawn</span>
      </div> -->

      <h1
        id="about-hero-title"
        class="about-hero-headline"
        style="font-size: 60px;"
      >
        About White Fawn<br />
      </h1>

      <div class="about-hero-meta">
        <div class="meta-pill">
          <svg
            class="meta-icon"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.588a13.06 13.06 0 003.031 2.198l.018.008.006.002.002.001zm.31-11.933a2 2 0 110 4 2 2 0 010-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Serving the Midwest</span>
        </div>
        <div class="meta-pill">
          <svg
            class="meta-icon"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a10.973 10.973 0 00-.012.949v5.99c0 .61.42 1.134 1.018 1.258a15.86 15.86 0 007.488 0A1.26 1.26 0 0014.75 15V8.999a10.97 10.97 0 00-.012-.95l2.646-1.133a1 1 0 000-1.84l-7-3zM10 4.223l5.08 2.177L10 8.577 4.92 6.4 10 4.223z"
            ></path>
          </svg>
          <span>Academic &amp; Cultural Strategy</span>
        </div>
        <div class="meta-pill">
          <svg
            class="meta-icon"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L2.414 11l3.293 3.293a1 1 0 11-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L17.586 11l-3.293-3.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Technical Expertise</span>
        </div>
      </div>

      <p class="about-hero-lead">
        White Fawn LLC unites academic inquiry with disciplined execution. We
        work with nonprofits, educational institutions, governmental
        institutions, and cultural organizations whose efforts elevate
        indigenous knowledge to enhance systems across the Midwest.
      </p>
    </div>
  </header>

  {
    /* ═══════════════════════════════════════════════════════════════════════
      2. Our Mission
      ═══════════════════════════════════════════════════════════════════════ */
  }
  <section
    id="mission"
    class="mission-section section"
    aria-labelledby="mission-heading"
  >
    <div class="container">
      <header class="section-header">
        <hr class="hero-divider" />
        <p class="section-eyebrow">Our Purpose</p>
        <h2 id="mission-heading" class="section-title">Our Mission</h2>
        <!-- <p class="section-lead">
          Equipping mission-driven organizations with the scholarship, tools,
          and technical autonomy required to safeguard their history and lead
          into the future.
        </p> -->
      </header>

      {/* Main Mission Manifesto Card */}
      <div class="manifesto-card glass-card">
        <div class="manifesto-content">
          <span class="manifesto-mark" aria-hidden="true">“</span>
          <p class="manifesto-text">
            To provide ethical, rigorous academic thought and sovereign
            technical implementation to nonprofits, educational institutions,
            governmental bodies, and cultural organizations across the
            Midwest—ensuring that indigenous knowledge is elevated to enhance
            systems, digital tools remain owned by those they serve, and
            impactful ideas are translated into enduring realities.
          </p>
        </div>
      </div>

      {/* Mission Pillars */}
      <div class="pillars-grid">
        <article class="pillar-card glass-card">
          <div class="pillar-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="pillar-title">Academic Stewardship</h3>
          <p class="pillar-text">
            We conduct thorough archival research, collaborative curriculum
            planning, and cultural resource evaluations that center community
            voices without compromising academic rigor.
          </p>
        </article>

        <article class="pillar-card glass-card">
          <div class="pillar-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <h3 class="pillar-title">Technical Capacity</h3>
          <p class="pillar-text">
            We build sustainable digital tools, databases, and websites designed
            so clients hold full ownership and control over their intellectual
            property, historical data, and infrastructure.
          </p>
        </article>

        <article class="pillar-card glass-card">
          <div class="pillar-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="pillar-title">Deep Regional Connection</h3>
          <p class="pillar-text">
            Our practice is intentionally regional. We understand the unique
            institutional landscapes, geographies, and histories of Midwest
            tribes, colleges, and cultural repositories.
          </p>
        </article>
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════════════════
      3. Our Vision
      ═══════════════════════════════════════════════════════════════════════ */
  }
  <section
    id="vision"
    class="vision-section section"
    aria-labelledby="vision-heading"
  >
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">Looking Ahead</p>
        <h2 id="vision-heading" class="section-title">Our Vision</h2>
        <p class="section-lead">
          A vast implementation of indigenous knowledge thoughtfully designed,
          culturally grounded, and built to endure to create systems that are
          resilient for the future.
        </p>
      </header>

      <div class="vision-grid">
        <div class="vision-card glass-card">
          <div class="vision-card-header">
            <span class="vision-number">01</span>
            <h3 class="vision-title">Centering Communities &amp; People</h3>
          </div>
          <p class="vision-text">
            We believe the most meaningful outcomes happen when human relationships
            and community voices lead the way. By centering the people we partner with,
            our work fosters collaborative stewardship and builds internal capacity
            that communities can carry forward with pride.
          </p>
        </div>

        <div class="vision-card glass-card">
          <div class="vision-card-header">
            <span class="vision-number">02</span>
            <h3 class="vision-title">Leveraging Indigenous Knowledge</h3>
          </div>
          <p class="vision-text">
            We leverage Indigenous Environmental Knowledge and time-tested cultural
            practices to inform modern technical and educational systems. By harmonizing
            ecological wisdom with reliable, accessible tools, we help create resilient
            frameworks designed to endure.
          </p>
        </div>

        <div class="vision-card glass-card">
          <div class="vision-card-header">
            <span class="vision-number">03</span>
            <h3 class="vision-title">Generational Impact</h3>
          </div>
          <p class="vision-text">
            Cultural preservation and education are enduring, multi-generational
            commitments. We measure the success of our work by how effectively our
            shared initiatives, curricula, and digital foundations continue to
            support learners, leaders, and communities for generations to come.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════════════════
      4. Our Team
      ═══════════════════════════════════════════════════════════════════════ */
  }
  <section
    id="team"
    class="team-section section"
    aria-labelledby="team-heading"
  >
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">The People</p>
        <h2 id="team-heading" class="section-title">Our Team</h2>
        <!-- <p class="section-lead">
          Leadership grounded in Indigenous Environmental Knowledge, cultural
          preservation, and ecological resilience.
        </p> -->
      </header>

      {
        /* ── Jorge Saiz Profile: Open 2-column layout (Text left, Image right, no card) ── */
      }
      <div class="founder-profile">
        <div class="founder-info">
          <h3 class="founder-name">{founder.name}</h3>
          <p class="founder-role">{founder.role}</p>
          <div class="founder-bio">
            <p>{founder.bio}</p>
          </div>
        </div>

        <div class="founder-visual">
          <div class="founder-image-frame">
            <img
              src={url("/jorge_saiz.jpg")}
              alt="Jorge Saiz — Founder of White Fawn LLC"
              class="founder-image"
              width="600"
              height="800"
              loading="eager"
            />
          </div>
        </div>
      </div>

      {
        /* ── Card template for future team members (preserved for expansion) ────────
      <div class="team-grid" style="display: none;">
        {futureTeamMembersTemplate.map((member) => (
          <article class="team-card glass-card">
            <div class="team-avatar-frame" aria-label={`Photo placeholder for ${member.name}`}>
              <div class="avatar-backdrop">
                <svg class="avatar-silhouette" viewBox="0 0 80 80" fill="currentColor" aria-hidden="true">
                  <path d="M40 42c8.837 0 16-7.163 16-16s-7.163-16-16-16-16 7.163-16 16 7.163 16 16 16zm0 8c-10.67 0-32 5.33-32 16v6h64v-6c0-10.67-21.33-16-32-16z" />
                </svg>
                <div class="avatar-initials-badge">{member.initials}</div>
              </div>
              <div class="placeholder-caption">
                <span class="placeholder-dot" />
                <span>Photo Placeholder</span>
              </div>
            </div>
            <div class="team-info">
              <h3 class="team-name">{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <div class="team-tags" aria-label="Areas of expertise">
                {member.tags.map((tag) => (
                  <span class="team-tag">{tag}</span>
                ))}
              </div>
              <p class="team-bio">{member.bio}</p>
            </div>
          </article>
        ))}
      </div>
      ─────────────────────────────────────────────────────────────────────────── */
      }
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════════════════
      5. Contact Box
      ═══════════════════════════════════════════════════════════════════════ */
  }
  <section
    id="contact-callout"
    class="contact-section section"
    aria-labelledby="contact-box-title"
  >
    <div class="container">
      <div class="contact-box glass-card">
        <div class="contact-box-content">
          <p class="contact-eyebrow">Connect With Us</p>
          <h2 id="contact-box-title" class="contact-headline">
            Let’s Build Something Meaningful Together
          </h2>
          <p class="contact-description">
            Whether your organization is embarking on a curriculum redesign,
            digitizing vital cultural archives, or planning sovereign community
            technology, we welcome the opportunity to listen and explore
            collaboration.
          </p>

          <div class="contact-actions">
            <Button variant="primary" href={url("/contact")}>
              Start a Conversation
            </Button>
            <a href="mailto:white.fawn0@gmail.com" class="contact-email-link">
              <svg
                class="email-icon"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                ></path>
                <path
                  d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                ></path>
              </svg>
              <span>white.fawn0@gmail.com</span>
            </a>
          </div>

          <!-- <div class="contact-footer-note">
            <span class="region-badge">Serving the Midwest Region</span>
            <span class="note-divider">•</span>
            <span
              >Educational Institutions, Nonprofits &amp; Tribal Organizations</span
            >
          </div> -->
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     Shared Section Styles
     ═══════════════════════════════════════════════════════════════════════════ */
  .section-header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-dark);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-title {
    font-size: var(--text-3xl);
    color: var(--color-secondary);
    line-height: var(--leading-tight);
  }

  .section-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     1. About Hero
     ═══════════════════════════════════════════════════════════════════════════ */
  .about-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-4);
    position: relative;
  }

  .about-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 52rem;
  }

  .hero-header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.375rem 1rem;
    background: var(--color-secondary-05);
    border: 1px solid var(--color-secondary-10);
    border-radius: var(--btn-radius);
    margin-bottom: var(--space-6);
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-dark);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-hero-headline {
    font-size: var(--text-4xl);
    color: var(--color-secondary);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .about-hero-lead {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
    max-width: 46ch;
    margin-bottom: 0;
  }

  .about-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: 4vh;
  }

  .hero-divider {
    width: 80vw;
    height: 5px;
    background-color: var(--color-secondary-20);
    border: none;
    border-radius: 0;
    clip-path: polygon(
      16px 0%,
      calc(100% - 16px) 0%,
      100% 50%,
      calc(100% - 16px) 100%,
      16px 100%,
      0% 50%
    );
    margin-top: 0;
    margin-bottom: var(--space-6);
    flex-shrink: 0;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--glass-border);
    border-radius: var(--btn-radius);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .meta-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-dark);
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     2. Mission Section
     ═══════════════════════════════════════════════════════════════════════════ */
  .mission-section {
    padding-top: var(--space-4);
  }

  .manifesto-card {
    padding: clamp(var(--space-8), 5vw, var(--space-12));
    margin-bottom: var(--space-8);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(240, 247, 252, 0.55) 100%
    );
    position: relative;
    overflow: hidden;
  }

  .manifesto-content {
    position: relative;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  .manifesto-mark {
    position: absolute;
    top: -2.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-size: 5rem;
    line-height: 1;
    color: var(--color-accent-20);
    pointer-events: none;
    user-select: none;
  }

  .manifesto-text {
    position: relative;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-secondary);
    font-style: italic;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--glass-padding);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--glass-shadow-hover);
  }

  .pillar-icon-box {
    width: 3.25rem;
    height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-10);
    border: 1px solid var(--color-accent-20);
    border-radius: 0.875rem;
    color: var(--color-accent-dark);
  }

  .pillar-icon-box svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .pillar-title {
    font-size: var(--text-lg);
    color: var(--color-secondary);
    font-weight: var(--font-weight-semibold);
  }

  .pillar-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     3. Vision Section
     ═══════════════════════════════════════════════════════════════════════════ */
  .vision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .vision-card {
    padding: var(--glass-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .vision-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--glass-shadow-hover);
  }

  .vision-card-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .vision-number {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    line-height: 1;
  }

  .vision-title {
    font-size: var(--text-lg);
    color: var(--color-secondary);
    line-height: var(--leading-snug);
