---
/**
 * BaseLayout.astro — Root layout for all pages.
 *
 * Responsibilities:
 *  - <html> / <head> with full SEO, OG, Twitter meta
 *  - Self-hosted font imports (via CSS)
 *  - Fixed background blob layer (glassmorphism backdrop)
 *  - Skip-to-content link
 *  - <Navbar /> and <Footer /> wrapping <slot />
 *
 * Props:
 *  title         Page <title> (appended with site name)
 *  description   Meta description
 *  ogImage       Open Graph image URL (default: placeholder)
 *  noindex       If true, adds noindex meta (e.g. for staging)
 */
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
import '../styles/glass.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'White Fawn LLC',
  description = 'Academic thought and technical implementation consulting for nonprofits, educational institutions, and organizations promoting indigenous cultures in the Midwest.',
  ogImage,
  noindex = false,
} = Astro.props;

const siteName   = 'White Fawn LLC';
const pageTitle  = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// TODO [OG-IMAGE]: Replace placeholder with an approved, community-appropriate image.
const ogImageURL = ogImage ?? `${Astro.site ?? ''}og-image.png`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {/* ── Favicon ────────────────────────────────────────────────────────── */}
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />

  {/* ── Primary SEO ────────────────────────────────────────────────────── */}
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  {/* ── Open Graph ─────────────────────────────────────────────────────── */}
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:site_name"   content={siteName} />
  <meta property="og:locale"      content="en_US" />

  {/* ── Twitter / X Card ───────────────────────────────────────────────── */}
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />

  {/* ── Theme color ────────────────────────────────────────────────────── */}
  <meta name="theme-color" content="#FAF9F6" />

  {/* ── Generator ──────────────────────────────────────────────────────── */}
  <meta name="generator" content={Astro.generator} />
</head>

<body>

  {/* ── Skip-to-content (accessibility) ──────────────────────────────────── */}
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {/* ═══════════════════════════════════════════════════════════════════════
      Background blob layer — fixed, non-interactive, behind all content.
      Provides the gradient backdrop that makes glass effects visible.

      Design rules:
       · Only --color-accent and --color-secondary at low opacity over --color-bg
       · Subtle and elegant — not neon, not saturated
       · pointer-events: none so they never intercept clicks
       · Animation disabled under prefers-reduced-motion

      TODO [IMAGERY]: When community-approved background imagery is available,
      replace or layer behind these blobs. Remove blobs if imagery is used.
      ═══════════════════════════════════════════════════════════════════════ */}
  <div class="bg-blobs" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
  </div>

  {/* ── Navigation ────────────────────────────────────────────────────────── */}
  <Navbar />

  {/* ── Main content ──────────────────────────────────────────────────────── */}
  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  {/* ── Footer ────────────────────────────────────────────────────────────── */}
  <Footer />

</body>
</html>

<style is:global>
  /* ── Background blob layer ──────────────────────────────────────────────── */
  .bg-blobs {
    position: fixed;
    inset: 0;
    z-index: var(--z-blobs);
    pointer-events: none;
    overflow: hidden;
    /* Isolate compositing context for performance */
    will-change: transform;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    /* Large soft blur creates natural, diffused gradient */
    filter: blur(var(--blob-blur, 80px));
    will-change: transform;
  }

  /* Blob 1 — accent, top-right, largest */
  .blob-1 {
    width: clamp(400px, 55vw, 900px);
    height: clamp(400px, 55vw, 900px);
    top: -15%;
    right: -10%;
    background: radial-gradient(
      ellipse at 40% 40%,
      rgba(49, 176, 245, var(--blob-accent-opacity, 0.12)) 0%,
      transparent 70%
    );
    animation: blob-drift-1 22s ease-in-out infinite;
  }

  /* Blob 2 — secondary, bottom-left */
  .blob-2 {
    width: clamp(300px, 45vw, 700px);
    height: clamp(300px, 45vw, 700px);
    bottom: -5%;
    left: -8%;
    background: radial-gradient(
      ellipse at 55% 55%,
      rgba(46, 64, 87, var(--blob-secondary-opacity, 0.07)) 0%,
      transparent 70%
    );
    animation: blob-drift-2 28s ease-in-out infinite;
  }

  /* Blob 3 — accent, bottom-right, subtle */
  .blob-3 {
    width: clamp(250px, 38vw, 600px);
    height: clamp(250px, 38vw, 600px);
    bottom: 15%;
    right: 5%;
    background: radial-gradient(
      circle,
      rgba(49, 176, 245, 0.08) 0%,
      transparent 70%
    );
    animation: blob-drift-3 32s ease-in-out infinite reverse;
  }

  /* Blob 4 — secondary, mid-left, very subtle */
  .blob-4 {
    width: clamp(200px, 30vw, 500px);
    height: clamp(200px, 30vw, 500px);
    top: 40%;
    left: 15%;
    background: radial-gradient(
      circle,
      rgba(46, 64, 87, 0.05) 0%,
      transparent 70%
    );
    animation: blob-drift-1 18s ease-in-out infinite 5s reverse;
  }

  @keyframes blob-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(2vw, -3vh) scale(1.04); }
    66%       { transform: translate(-1.5vw, 2.5vh) scale(0.97); }
  }

  @keyframes blob-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(2.5vw, 3vh) scale(1.03); }
    70%       { transform: translate(-1vw, -2vh) scale(0.98); }
  }

  @keyframes blob-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    35%       { transform: translate(-2vw, -2.5vh) scale(1.05); }
    65%       { transform: translate(1.5vw, 3vh) scale(0.96); }
  }

  /* Disable all blob animation for reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none !important;
    }
  }

  /* ── Main content area ──────────────────────────────────────────────────── */
  main:focus {
    outline: none; /* Focus outline suppressed on main; skip link handles a11y */
  }
</style>
