---
/**
 * Navbar.astro — Sticky glass navigation bar.
 *
 * Desktop: Wordmark LEFT | nav links + Contact CTA RIGHT
 * Mobile (<768px): Wordmark LEFT | hamburger RIGHT → glass dropdown panel
 *
 * Nav items are driven entirely by src/data/nav.ts.
 * The hamburger toggle logic lives in src/scripts/nav.js (vanilla JS).
 */
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import { navItems, url } from '../data/nav.ts';
---

<header class="site-header glass-nav" role="banner">
  <nav class="nav-inner container" aria-label="Primary">

    <Wordmark />

    {/* ── Desktop links ──────────────────────────────────────────────────── */}
    <ul class="nav-links" role="list">
      {navItems.map((item) =>
        item.variant === 'button' ? (
          <li>
            <Button variant="contact" href={url(item.href)}>
              {item.label}
            </Button>
          </li>
        ) : (
          <li>
            <a
              href={item.href.startsWith('#') ? item.href : url(item.href)}
              class="nav-link"
            >
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>

    {/* ── Hamburger button (mobile only) ─────────────────────────────────── */}
    <button
      id="nav-toggle"
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open navigation menu"
    >
      {/* Animated three-bar → X icon */}
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </nav>

  {/* ── Mobile dropdown panel ──────────────────────────────────────────────── */}
  <div
    id="nav-menu"
    class="nav-mobile-menu glass-menu"
    hidden
    role="dialog"
    aria-label="Navigation menu"
  >
    <ul class="nav-mobile-list" role="list">
      {navItems.map((item) =>
        item.variant === 'button' ? (
          <li>
            <Button variant="primary" href={url(item.href)} style="width: 100%; justify-content: center;">
              {item.label}
            </Button>
          </li>
        ) : (
          <li>
            <a
              href={item.href.startsWith('#') ? item.href : url(item.href)}
              class="nav-mobile-link"
            >
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>
  </div>
</header>

{/* ── Hamburger JS (no framework, no hydration overhead) ─────────────────────── */}
<script src="../scripts/nav.js"></script>

<style>
  /* ── Site header wrapper ─────────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--nav-height);
  }

  /* ── Nav inner: flex row, space-between ──────────────────────────────────── */
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-4);
  }

  /* ── Desktop nav links ────────────────────────────────────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    position: relative;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary);
    text-decoration: none;
    padding-block: var(--space-1);
    min-height: var(--btn-min-target);
    display: inline-flex;
    align-items: center;
  }

  /* Accent underline on hover / active */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    border-radius: 1px;
    transition: transform var(--transition-base);
  }

  .nav-link:hover::after,
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  /* ── Hamburger button ─────────────────────────────────────────────────────── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    padding: var(--space-2);
    color: var(--color-secondary);
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-toggle:hover {
    background: var(--color-secondary-08);
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform var(--transition-base),
      opacity var(--transition-fast);
  }

  /* X icon when expanded */
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar,
    .nav-toggle {
      transition: none;
    }
  }

  /* ── Mobile menu panel ────────────────────────────────────────────────────── */
  .nav-mobile-menu {
    position: absolute;
    top: calc(var(--nav-height) + var(--space-2));
    left: var(--content-padding);
    right: var(--content-padding);
    z-index: var(--z-nav);
    padding: var(--space-6);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .nav-mobile-menu[data-open] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-mobile-menu {
      transition: none;
    }
  }

  .nav-mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .nav-mobile-link {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary);
    padding: var(--space-3) var(--space-4);
    min-height: var(--btn-min-target);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    transition: background var(--transition-fast);
  }

  .nav-mobile-link:hover {
    background: var(--color-secondary-05);
  }

  /* ── Responsive: show hamburger, hide desktop links on mobile ─────────────── */
  @media (max-width: 767px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  /* ── Ensure mobile menu is truly hidden on desktop ────────────────────────── */
  @media (min-width: 768px) {
    .nav-mobile-menu {
      display: none !important;
    }
  }
</style>
