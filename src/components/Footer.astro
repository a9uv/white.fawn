---
/**
 * Footer.astro — Site footer, standardized for 2026 LLC launch.
 *
 * Copyright year is generated dynamically at build time.
 * All placeholder content is marked with TODO.
 *
 * Do NOT invent: street address, phone, registration number.
 * Use TODO placeholders for all contact / legal details.
 */
import Wordmark from './Wordmark.astro';
import { footerNavItems, legalLinks, url } from '../data/nav.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container">

    {/* ── Top section ──────────────────────────────────────────────────────── */}
    <div class="footer-top">

      <div class="footer-brand">
        <Wordmark />
        {/* TODO [COPY]: Replace with approved one-line brand descriptor. */}
        <p class="footer-descriptor">
          Academic thought &amp; technical implementation consulting<br />
          for indigenous-culture-focused organizations in the Midwest.
        </p>
        {/* TODO [CONTACT]: Replace placeholder email with real contact address. */}
        <a href="mailto:hello@example.com" class="footer-email">
          hello@example.com
        </a>
        <p class="footer-region">Serving the Midwest, USA</p>
      </div>

      <div class="footer-links-group">
        <p class="footer-links-heading">Navigate</p>
        <ul class="footer-links-list" role="list">
          {footerNavItems.map((item) => (
            <li>
              <a
                href={item.href.startsWith('#') ? item.href : url(item.href)}
                class="footer-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-links-group">
        <p class="footer-links-heading">Legal</p>
        <ul class="footer-links-list" role="list">
          {legalLinks.map((link) => (
            <li>
              {/* Phase 2 placeholder pages — do not exist yet */}
              <a href={url(link.href)} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    {/* ── Bottom bar ───────────────────────────────────────────────────────── */}
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {year} White Fawn LLC. All rights reserved.
      </p>

      {/*
        TODO [COMMUNITY]: Replace or remove the commented block below with an
        approved land or community acknowledgment written by the client.
        This acknowledgment should be authored by or in collaboration with
        the communities referenced.

        Example structure (do NOT use this placeholder text publicly):
        <p class="footer-acknowledgment">
          We acknowledge that we operate on the ancestral lands of the [Nation(s)],
          and we are grateful for the opportunity to support the ongoing vitality
          of indigenous cultures in the Midwest.
        </p>
      */}
    </div>

  </div>
</footer>

<style>
  /* ── Footer wrapper ─────────────────────────────────────────────────────── */
  .site-footer {
    background: var(--color-secondary-05);
    border-top: 1px solid var(--color-secondary-10);
    margin-top: auto;
  }

  .footer-inner {
    padding-block: var(--space-12) var(--space-8);
  }

  /* ── Top section: 3-column grid ─────────────────────────────────────────── */
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-secondary-10);
  }

  /* ── Brand column ───────────────────────────────────────────────────────── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-descriptor {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
    max-width: 30ch;
  }

  .footer-email {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-50);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast);
  }

  .footer-email:hover {
    text-decoration-color: var(--color-accent);
  }

  .footer-region {
    font-size: var(--text-xs);
    color: var(--color-secondary-50);
    max-width: none;
  }

  /* ── Links columns ──────────────────────────────────────────────────────── */
  .footer-links-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-links-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-secondary-50);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: none;
  }

  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary-70);
    text-decoration: none;
    transition: color var(--transition-fast);
    min-height: var(--btn-min-target);
    display: inline-flex;
    align-items: center;
  }

  .footer-link:hover {
    color: var(--color-secondary);
  }

  /* ── Bottom bar ─────────────────────────────────────────────────────────── */
  .footer-bottom {
    padding-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-secondary-50);
    max-width: none;
  }

  .footer-acknowledgment {
    font-size: var(--text-xs);
    color: var(--color-secondary-50);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
    font-style: italic;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
