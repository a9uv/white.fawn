---
/**
 * Hero.astro — Full-width hero section.
 *
 * This is the ONLY <h1> on the page.
 * All copy below is PLACEHOLDER — replace before launch.
 */
import Button from "./Button.astro";
import { url } from "../data/nav.ts";
---

<section class="hero" aria-label="Introduction">
  <div class="hero-inner container">
    <div class="hero-content">
      {
        /* ── PLACEHOLDER COPY — replace before launch ──────────────────────
          TODO: Replace headline with approved brand headline.
          TODO: Replace subtext with approved brand description.
          ─────────────────────────────────────────────────────────────── */
      }
      <p class="hero-eyebrow">Promoting Indigenous Knowledge</p>

      <h1 class="hero-headline">
        Rigorous Thought.<br /> Purposeful Action
      </h1>

      <p class="hero-subtext">
        {/* TODO [COPY]: Replace with approved brand copy. */}
        White Fawn partners with nonprofits, educational institutions, and organizations
        to enhance systems through indigenous knowledge across the Midwest — bringing
        academic depth and hands-on technical implementation to the work that matters.
      </p>

      <div class="hero-actions">
        {/* Primary CTA → Contact page (Phase 2 placeholder) */}
        <Button variant="primary" href={url("/contact")}>
          Start a Conversation
        </Button>

        {/* Secondary CTA → Portfolio page (Phase 2 placeholder) */}
        <Button variant="secondary" href={url("/portfolio")}>
          View Our Work
        </Button>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-image-card">
        <img
          src={url("/lake_michigan_beach.jpg")}
          alt="Lake Michigan shoreline and beach — a natural landscape of the Midwest region served by White Fawn"
          class="hero-image"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-20);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--space-16);
  }

  /* ── Text content ─────────────────────────────────────────────────────────── */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 40rem;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-dark);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: none;
    /* --color-accent-dark (#1A6AB5) on --color-bg (#FAF9F6) is ~5.1:1 (WCAG AA ✓)
       at this font size + weight, so it can be used for text here. */
  }

  .hero-headline {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--color-secondary);
  }

  .hero-subtext {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
    max-width: 52ch;
  }

  /* ── CTA buttons row ──────────────────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-top: var(--space-2);
  }

  /* ── Visual / Image side ─────────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center; /* Vertically centers the card within the column */
  }

  .hero-image-card {
    position: relative;
    width: 100%;
    height: 90%; /* Takes 60% height, leaving exactly 20% above and 20% below */
    min-height: 0;
    overflow: hidden;
    border-radius: var(--glass-radius);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: flex;
    transition: transform var(--transition-base);
  }

  .hero-image-card:hover .hero-image {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image-card:hover .hero-image {
      transform: none;
    }
  }

  /* ── Responsive ────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .hero-visual {
      max-width: 24rem;
      margin-inline: auto;
      height: auto;
    }

    .hero-image-card {
      aspect-ratio: 4 / 3;
      height: auto;
    }

    .hero-content {
      max-width: 100%;
      text-align: center;
      align-items: center;
    }

    .hero-headline br {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-block: var(--space-12);
      min-height: auto;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
