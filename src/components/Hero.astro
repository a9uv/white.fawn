---
/**
 * Hero.astro — Full-width hero section.
 *
 * This is the ONLY <h1> on the page.
 * All copy below is PLACEHOLDER — replace before launch.
 */
import Button from "./Button.astro";
import { url } from "../data/nav.ts";
---

<section class="hero" aria-label="Introduction">
  <div class="hero-inner container">
    <div class="hero-content">
      {
        /* ── PLACEHOLDER COPY — replace before launch ──────────────────────
          TODO: Replace headline with approved brand headline.
          TODO: Replace subtext with approved brand description.
          ─────────────────────────────────────────────────────────────── */
      }
      <p class="hero-eyebrow">Promoting Indigenous Knowledge</p>

      <h1 class="hero-headline">
        Rigorous Thought.<br /> Purposeful Action
      </h1>

      <p class="hero-subtext">
        {/* TODO [COPY]: Replace with approved brand copy. */}
        White Fawn partners with nonprofits, educational institutions, and organizations
        to enhance systems through indigenous knowledge across the Midwest — bringing
        academic depth and hands-on technical implementation to the work that matters.
      </p>

      <div class="hero-actions">
        {/* Primary CTA → Contact page (Phase 2 placeholder) */}
        <Button variant="primary" href={url("/contact")}>
          Start a Conversation
        </Button>

        {/* Secondary CTA → Portfolio page (Phase 2 placeholder) */}
        <Button variant="secondary" href={url("/portfolio")}>
          View Our Work
        </Button>
      </div>
    </div>

    {
      /* ── PLACEHOLDER: Community-approved imagery goes here ──────────────────
        TODO [IMAGERY]: Replace with community-approved, nature-inspired imagery.
        Do NOT use feathers, dreamcatchers, arrowheads, headdresses,
        or any pan-Indian stereotype.
        Suggested: abstract landscape abstraction, botanical illustration,
        or a photo of the Midwest landscape.
        ──────────────────────────────────────────────────────────────────── */
    }
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-orb hero-orb--3"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-20);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-16);
  }

  /* ── Text content ─────────────────────────────────────────────────────────── */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 40rem;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-dark);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: none;
    /* --color-accent-dark (#1A6AB5) on --color-bg (#FAF9F6) is ~5.1:1 (WCAG AA ✓)
       at this font size + weight, so it can be used for text here. */
  }

  .hero-headline {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--color-secondary);
  }

  .hero-subtext {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary-70);
    max-width: 52ch;
  }

  /* ── CTA buttons row ──────────────────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-top: var(--space-2);
  }

  /* ── Visual / decorative side ─────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    max-width: 28rem;
    margin-inline: auto;
  }

  /* Abstract orbs — nature-inspired, non-stereotypical decorative shapes.
     These serve as placeholder until community-approved imagery is provided. */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .hero-orb--1 {
    width: 75%;
    height: 75%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse at 35% 40%,
      rgba(49, 176, 245, 0.22) 0%,
      rgba(49, 176, 245, 0.06) 50%,
      transparent 75%
    );
    animation: orb-breathe 8s ease-in-out infinite;
  }

  .hero-orb--2 {
    width: 55%;
    height: 55%;
    top: 10%;
    right: 5%;
    background: radial-gradient(
      ellipse at 60% 30%,
      rgba(46, 64, 87, 0.12) 0%,
      transparent 70%
    );
    animation: orb-drift 12s ease-in-out infinite reverse;
  }

  .hero-orb--3 {
    width: 40%;
    height: 40%;
    bottom: 8%;
    left: 8%;
    background: radial-gradient(
      circle,
      rgba(49, 176, 245, 0.14) 0%,
      transparent 70%
    );
    animation: orb-breathe 10s ease-in-out infinite 2s;
  }

  @keyframes orb-breathe {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @keyframes orb-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    40% {
      transform: translate(8%, -5%) scale(1.05);
    }
    70% {
      transform: translate(-4%, 6%) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb {
      animation: none;
    }
  }

  /* ── Responsive ────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .hero-visual {
      display: none; /* Hide decorative visual on smaller screens */
    }

    .hero-content {
      max-width: 100%;
      text-align: center;
      align-items: center;
    }

    .hero-headline br {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-block: var(--space-12);
      min-height: auto;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
